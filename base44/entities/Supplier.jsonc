{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier company name"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email address"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "notes": {
      "type": "string",
      "description": "Notes e.g. usual hire terms, account number"
    }
  },
  "required": [
    "name"
  ]
}
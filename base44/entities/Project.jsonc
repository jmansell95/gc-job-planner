{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name \u2014 the parent container that groups one or more jobs (e.g. a multi-site investigation with 5 borehole jobs)."
    },
    "division_id": {
      "type": "string",
      "description": "The division this project belongs to. Set automatically from the active division when the project is created. Drives division-scoped filtering \u2014 a division only sees its own projects. Blank = unassigned (visible to enterprise admins only)."
    },
    "reference": {
      "type": "string",
      "description": "Project reference / quote number (e.g. PRJ-2026-014)."
    },
    "client_id": {
      "type": "string",
      "description": "Associated client for this project."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "on_hold"
      ],
      "default": "active",
      "description": "Project status \u2014 used for filtering and reporting."
    },
    "notes": {
      "type": "string",
      "description": "Project-level notes (scope, contract terms, shared requirements across all jobs)."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    }
  }
}
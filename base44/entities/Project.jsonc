{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name \u2014 the parent container that groups one or more jobs (e.g. a multi-site investigation with 5 borehole jobs)."
    },
    "reference": {
      "type": "string",
      "description": "Project reference / quote number (e.g. PRJ-2026-014)."
    },
    "client_id": {
      "type": "string",
      "description": "Associated client for this project."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "on_hold"
      ],
      "default": "active",
      "description": "Project status \u2014 used for filtering and reporting."
    },
    "notes": {
      "type": "string",
      "description": "Project-level notes (scope, contract terms, shared requirements across all jobs)."
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "CVRLineItem",
  "type": "object",
  "properties": {
    "cvr_id": {
      "type": "string",
      "description": "The CVR this line item belongs to."
    },
    "job_id": {
      "type": "string",
      "description": "The job this line item belongs to (denormalised for direct job-level queries)."
    },
    "description": {
      "type": "string",
      "description": "Cost category description (e.g. 'Prelims', 'CP Rig and Crew', 'Rotary Rig and Crew'). Pulled from the CVR sheet 'Description' column."
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name from Power BI (the CVR sheet 'Supplier (from PowerBi)' column). Blank for internal cost categories."
    },
    "tender_value": {
      "type": "number",
      "description": "Original tendered value for this cost category. Pulled from the CVR sheet 'Tender Value' column."
    },
    "vo_values": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vo_number": {
            "type": "string",
            "description": "Variation order reference (e.g. 'VO.1', 'VO.2')."
          },
          "value": {
            "type": "number",
            "description": "Variation amount for this line item under this VO."
          }
        },
        "required": [
          "vo_number"
        ]
      },
      "default": [],
      "description": "Variation order values applied to this line item. Each entry maps a VO reference to its value. The CVR sheet has columns VO.1 through VO.10 \u2014 each non-empty cell becomes an entry here."
    },
    "forecast_final_value": {
      "type": "number",
      "description": "Forecast final value for this line item = tender_value + sum of VO values. Auto-calculated, or overridden from the CVR sheet."
    },
    "total_order": {
      "type": "number",
      "description": "Total order value for this line item. Pulled from the CVR sheet 'Total Order' column."
    },
    "invoiced_costs": {
      "type": "number",
      "description": "Costs invoiced to date for this line item. Pulled from the CVR sheet 'Invoiced Costs' column."
    },
    "committed_costs": {
      "type": "number",
      "description": "Costs committed but not yet invoiced. Pulled from the CVR sheet 'Committed Costs' column."
    },
    "orders_not_placed": {
      "type": "number",
      "description": "Estimated value of orders not yet placed (plus/minus adjustment). Pulled from the CVR sheet 'Orders not placed' column."
    },
    "defects_contingency": {
      "type": "number",
      "description": "Defects / contingency allowance for this line item. Pulled from the CVR sheet 'Defects / Contingency' column."
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost = invoiced_costs + committed_costs + orders_not_placed + defects_contingency. Auto-calculated, or overridden from the CVR sheet."
    },
    "profit_loss": {
      "type": "number",
      "description": "Profit/loss for this line item = forecast_final_value - total_cost. Auto-calculated by recalculateCVR."
    },
    "profit_pct": {
      "type": "number",
      "description": "Profit margin % = (profit_loss / forecast_final_value) \u00d7 100. Auto-calculated by recalculateCVR."
    },
    "comments": {
      "type": "string",
      "description": "Comments from the CVR sheet 'Comments' column. Free-text notes about this cost category."
    },
    "pct_on_site": {
      "type": "number",
      "description": "% of this line item's work that is on site / complete. Pulled from the CVR sheet '% On Site' column."
    },
    "costs_to_date": {
      "type": "number",
      "description": "Costs incurred to date for this line item. Pulled from the CVR sheet 'Costs to Date' column."
    },
    "value_to_date": {
      "type": "number",
      "description": "Value of production to date for this line item. Pulled from the CVR sheet 'Value to Date' column."
    },
    "pl_to_date": {
      "type": "number",
      "description": "Profit/loss to date for this line item = value_to_date - costs_to_date. Auto-calculated or pulled from the CVR sheet."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the CVR line items table (matches the row order in the original spreadsheet)."
    }
  },
  "required": [
    "cvr_id",
    "job_id",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
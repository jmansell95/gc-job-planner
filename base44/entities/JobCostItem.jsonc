{
  "name": "JobCostItem",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Associated job"
    },
    "category": {
      "type": "string",
      "enum": [
        "internal_equipment",
        "hired_equipment",
        "purchased_equipment",
        "contractor_supplied",
        "client_supplied"
      ],
      "default": "hired_equipment",
      "description": "How this item reaches site. 'internal_equipment' = owned by you (synced from Asset Panda), 'hired_equipment' = hired from a supplier, 'purchased_equipment' = bought for the job (requires PO number and order slip), 'contractor_supplied' = supplied by the contractor (no cost/logistics), 'client_supplied' = supplied by the client and delivered to site (informational only \u2014 no cost or charge)."
    },
    "supplier_id": {
      "type": "string",
      "description": "Supplier (for hired or purchased equipment)"
    },
    "contractor_id": {
      "type": "string",
      "description": "Contractor supplying this item (when category is 'contractor_supplied'). The contractor is responsible for delivering it to site \u2014 no collection or delivery task is created for our drivers."
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem from the Master Price List \u2014 set automatically when an item is picked from the rate card. Keeps the description, unit cost and unit label in sync with the source rate, and marks the item as chargeable to the client."
    },
    "description": {
      "type": "string",
      "description": "Item description e.g. Transformer, Excavator"
    },
    "reference_number": {
      "type": "string",
      "description": "Reference / asset tag / serial number for tracking"
    },
    "responsible_person": {
      "type": "string",
      "description": "Person responsible for this equipment (carried over from the catalogue / GC Compliance Manager)"
    },
    "site_asset_id": {
      "type": "string",
      "description": "Linked SiteAsset (from GC Compliance Manager / Asset Panda) \u2014 keeps this cost item connected to live compliance status. Used for rigs and owned equipment."
    },
    "po_number": {
      "type": "string",
      "description": "Purchase order number for this hire or purchase. Required when category is 'purchased_equipment'."
    },
    "order_slip_url": {
      "type": "string",
      "description": "URL of the uploaded order slip / purchase document. Required for purchased equipment to evidence the supplier order."
    },
    "order_slip_name": {
      "type": "string",
      "description": "Original filename of the uploaded order slip."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Hire start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Hire end date"
    },
    "unit_cost": {
      "type": "number",
      "description": "Net cost per unit (excluding VAT). Zero for contractor/client-supplied items. Auto-filled from the linked RateCardItem when picked from the Master Price List."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of units / days"
    },
    "unit_label": {
      "type": "string",
      "default": "day",
      "description": "Unit label e.g. day, each, m, hour"
    },
    "men": {
      "type": "number",
      "description": "Crew size auto-filled from the linked RateCardItem (labour items only). The total daily cost is calculated as unit_cost \u00d7 men for per-day items. Not manually editable \u2014 sourced from the rate card."
    },
    "vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is exempt from VAT"
    },
    "hire_status": {
      "type": "string",
      "enum": [
        "active",
        "off_hired"
      ],
      "default": "active",
      "description": "Whether hired equipment is still on site or returned to supplier"
    },
    "current_location": {
      "type": "string",
      "enum": [
        "yard",
        "in_transit",
        "site",
        "returned"
      ],
      "default": "yard",
      "description": "Live tracking of where this item physically is: yard (at depot), in_transit (on a vehicle), site (on the job), returned (collected and returned to depot/supplier/contractor). Contractor/client-supplied items default to 'site' since they are delivered directly."
    },
    "return_destination": {
      "type": "string",
      "description": "Where this item was returned to when collected: 'depot', a supplier_id, or a contractor_id. Set when current_location becomes 'returned'."
    },
    "location_updated_at": {
      "type": "string",
      "description": "ISO timestamp of when current_location was last changed"
    },
    "off_hire_date": {
      "type": "string",
      "format": "date",
      "description": "Date the equipment was returned / off-hired"
    },
    "off_hire_note_url": {
      "type": "string",
      "description": "URL of the uploaded off-hire / return note document"
    },
    "off_hire_note_name": {
      "type": "string",
      "description": "Original filename of the off-hire note"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes for equipment delivery (address, contact, timing)"
    },
    "collection_notes": {
      "type": "string",
      "description": "Notes for equipment collection (date, contact, return condition)"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "job_id",
    "category",
    "description",
    "unit_cost"
  ]
}
{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Equipment name"
    },
    "type": {
      "type": "string",
      "enum": [
        "drill",
        "pump",
        "generator",
        "vehicle",
        "tool",
        "other"
      ],
      "description": "Equipment type"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial/reference number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "checked_out",
        "maintenance"
      ],
      "default": "available",
      "description": "Equipment status"
    },
    "assigned_job_id": {
      "type": "string",
      "description": "Job currently assigned to"
    },
    "assigned_staff_id": {
      "type": "string",
      "description": "Staff member who checked it out"
    },
    "checkout_date": {
      "type": "string",
      "format": "date",
      "description": "Date checked out"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Expected return date"
    }
  },
  "required": [
    "name",
    "type"
  ]
}
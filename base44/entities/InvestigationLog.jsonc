{
  "name": "InvestigationLog",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Job this log entry belongs to"
    },
    "assignment_id": {
      "type": "string",
      "description": "RotaAssignment this log was recorded from (optional)"
    },
    "staff_id": {
      "type": "string",
      "description": "Staff member who recorded the log"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (for display)"
    },
    "completed_by_type": {
      "type": "string",
      "enum": [
        "internal_staff",
        "client",
        "contractor"
      ],
      "default": "internal_staff",
      "description": "Who performed the logged activity. 'internal_staff' (default) = our own crew; 'client' = work carried out by the client's own personnel; 'contractor' = work carried out by another contractor on site. The log timestamp is captured automatically in created_at."
    },
    "completed_by_name": {
      "type": "string",
      "description": "Name of the client/contractor representative who performed the work. Blank for internal staff (uses staff_name)."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the work was carried out"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "borehole_progress",
        "sample_collection",
        "window_sampling",
        "pit_excavation",
        "inspection_pit",
        "installation",
        "grouting_works",
        "site_setup",
        "reinstatement",
        "standpipe_reading",
        "geophysical_probing",
        "borehole_decommissioning",
        "core_inspection",
        "other"
      ],
      "description": "Type of investigation activity. Drilling jobs use borehole_progress/sample_collection/window_sampling/standpipe_reading/geophysical_probing/borehole_decommissioning/core_inspection; groundworks use pit_excavation/inspection_pit/installation/grouting_works; enabling crews use site_setup/reinstatement."
    },
    "borehole_ref": {
      "type": "string",
      "description": "Borehole or pit reference (e.g. BH-01, CP-03, TP-02) \u2014 used for both drilling and trial pit logs"
    },
    "depth_from": {
      "type": "number",
      "description": "Start depth in metres (for borehole progress or pit excavation)"
    },
    "depth_to": {
      "type": "number",
      "description": "End depth in metres (for borehole progress or pit excavation)"
    },
    "sample_id": {
      "type": "string",
      "description": "Sample reference number (e.g. S-01, UDS-02)"
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "disturbed",
        "undisturbed",
        "water",
        "none"
      ],
      "default": "none",
      "description": "Type of sample collected"
    },
    "units_completed": {
      "type": "number",
      "description": "Number of units completed (e.g. 2 EV chargers installed, 3 trial pits dug)"
    },
    "units_label": {
      "type": "string",
      "description": "Unit label (e.g. 'chargers', 'pits', 'metres')"
    },
    "dimensions": {
      "type": "string",
      "description": "Dimensions (e.g. '1.2m x 0.8m x 1.5m deep' for trial pits)"
    },
    "description": {
      "type": "string",
      "description": "Description of the work carried out or observations (ground conditions, obstructions, etc.)"
    },
    "duration_minutes": {
      "type": "number",
      "description": "How long this activity took in minutes"
    },
    "photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of evidence photos"
    },
    "created_at": {
      "type": "string",
      "description": "ISO timestamp when this log was created"
    },
    "spt_blows": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "SPT blow counts at each 75mm increment (e.g. [3, 4, 5] = N-value 9 for the final two increments). BS 5930 standard."
    },
    "spt_n_value": {
      "type": "number",
      "description": "Calculated SPT N-value (sum of blows for the 2nd and 3rd increments). Auto-calculated from spt_blows if not manually set."
    },
    "groundwater_strike_depth": {
      "type": "number",
      "description": "Depth in metres at which groundwater was first encountered during drilling or excavation"
    },
    "groundwater_static_level": {
      "type": "number",
      "description": "Depth in metres to the stabilised groundwater level, measured after allowing time for equilibrium (usually 24h)"
    },
    "drilling_fluid_loss": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "total"
      ],
      "default": "none",
      "description": "Drilling fluid (bentonite/water) loss during rotary or cable percussion drilling. 'none' = full return, 'partial' = reduced return, 'total' = complete loss of circulation (indicates open void or highly fractured ground)."
    },
    "fluid_return_quality": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "lost"
      ],
      "default": "full",
      "description": "Quality of drilling fluid return to surface. 'full' = normal return, 'partial' = reduced return, 'lost' = no return. Used alongside drilling_fluid_loss for borehole stability assessment."
    },
    "refusal_encountered": {
      "type": "boolean",
      "default": false,
      "description": "Whether drilling or probing refusal was encountered (could not advance further). When true, obstruction_type and description should record the cause (boulder, obstructions, services, etc.)."
    },
    "obstruction_type": {
      "type": "string",
      "enum": [
        "none",
        "boulder",
        "concrete",
        "utilities",
        "void",
        "other"
      ],
      "default": "none",
      "description": "Type of obstruction encountered during drilling or excavation. 'boulder' = large cobble/boulder, 'concrete' = concrete obstruction, 'utilities' = service/utility clash, 'void' = void encountered, 'other' = see description."
    },
    "standpipe_ref": {
      "type": "string",
      "description": "Standpipe piezometer reference (e.g. SP-01, BH-02/SP1). Used for standpipe_reading log type to track water level monitoring over time."
    },
    "standpipe_reading_m": {
      "type": "number",
      "description": "Standpipe water level reading in metres below ground level (mBGL). Recorded during monitoring visits to track groundwater levels over time."
    },
    "standpipe_dip_depth_m": {
      "type": "number",
      "description": "Depth to water measured from the top of the standpipe casing (m below TOC). Used when borehole casing elevation isn't known, converted to mBGL later."
    },
    "strata_descriptor": {
      "type": "string",
      "enum": [
        "topsoil",
        "made_ground",
        "clay_soft",
        "clay_firm",
        "clay_stiff",
        "sand_loose",
        "sand_medium_dense",
        "sand_dense",
        "gravel",
        "silt",
        "peat",
        "chalk",
        "mudstone",
        "sandstone",
        "limestone",
        "granite",
        "concrete",
        "tarmac",
        "other"
      ],
      "default": "other",
      "description": "Standardised strata classification per BS 5930 for consistent borehole and pit logging"
    },
    "strata_description_detail": {
      "type": "string",
      "description": "Free-text detail supplementing the standardised strata descriptor (e.g. 'firm grey slightly sandy CLAY with gravel pockets')"
    },
    "coring_rqd": {
      "type": "number",
      "description": "Rock Quality Designation percentage \u2014 sum of intact core pieces \u2265100mm divided by total core run length. Used for rotary coring only."
    },
    "coring_recovery": {
      "type": "number",
      "description": "Core recovery percentage \u2014 length of recovered core divided by total core run length. Used for rotary coring only."
    },
    "core_run_number": {
      "type": "string",
      "description": "Core run reference (e.g. C1, C2) for rotary coring logs"
    },
    "core_box_number": {
      "type": "string",
      "description": "Core box number for core_inspection logs \u2014 used to track and photograph boxed core from rotary drilling for laboratory dispatch."
    },
    "pit_stability_rating": {
      "type": "string",
      "enum": [
        "stable",
        "minor_slumping",
        "collapse",
        "not_assessed"
      ],
      "default": "not_assessed",
      "description": "Wall stability assessment for trial pits \u2014 'stable' = no movement, 'minor_slumping' = some material falling, 'collapse' = significant sidewall failure. Mandatory for trial pit and inspection pit logs."
    },
    "service_encounter_type": {
      "type": "string",
      "enum": [
        "none",
        "gas",
        "water",
        "electric",
        "telecom",
        "drainage",
        "unknown"
      ],
      "default": "none",
      "description": "Type of underground service encountered during excavation. 'none' = no services found; any other value forces a GPS coordinate capture for the hazard map."
    },
    "service_encounter_gps": {
      "type": "string",
      "description": "GPS coordinates (lat,lng) of any service encountered \u2014 mandatory when service_encounter_type is not 'none'. Used for the live site hazard map."
    },
    "service_check_by_type": {
      "type": "string",
      "enum": [
        "internal_staff",
        "client",
        "contractor"
      ],
      "default": "internal_staff",
      "description": "Who performed the service check / verification when a service was encountered. Lets the crew record that the client or a contractor carried out the service check (e.g. before continuing to dig), rather than assuming our staff always did it."
    },
    "service_check_by_name": {
      "type": "string",
      "description": "Name of the person who performed the service check. Required when service_check_by_type is 'client' or 'contractor'."
    },
    "service_check_at": {
      "type": "string",
      "description": "ISO timestamp of when the service check was carried out. Auto-set to the current time when the log is saved; the time is displayed alongside the checker's name on the audit trail."
    },
    "cbr_value": {
      "type": "number",
      "description": "California Bearing Ratio test result (%) \u2014 in-situ strength testing performed in trial pits or at formation level"
    },
    "vane_strength": {
      "type": "number",
      "description": "Hand vane shear strength test result (kPa) \u2014 in-situ strength testing of cohesive soils"
    },
    "verification_photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of pre-dig and post-dig verification photos \u2014 used by enabling crews for reinstatement evidence"
    },
    "reinstatement_type": {
      "type": "string",
      "enum": [
        "none",
        "backfilled",
        "granular_fill",
        "concrete",
        "tarmac",
        "left_open",
        "other"
      ],
      "default": "none",
      "description": "Type of reinstatement carried out after the investigation \u2014 for enabling/reinstatement logs"
    },
    "backfill_material": {
      "type": "string",
      "description": "Material used for backfilling (e.g. 'Type 1 granular', 'site-won clay', 'foam concrete', 'bentonite pellets')"
    },
    "grout_volume": {
      "type": "number",
      "description": "Volume of grout mixed/placed in litres (grouting_works log type). Used for material consumption tracking and billing."
    },
    "mixer_type": {
      "type": "string",
      "enum": [
        "machine_mixer",
        "hand_mix",
        "ready_mixed",
        "none"
      ],
      "default": "none",
      "description": "Mixing method used for grouting. 'machine_mixer' = powered colloidal/paddle mixer, 'hand_mix' = manual mixing, 'ready_mixed' = delivered premixed, 'none' = not applicable."
    },
    "grout_mix_ratio": {
      "type": "string",
      "description": "Grout mix ratio (e.g. '1:1 cement:bentonite', 'Cement 25kg + 12L water'). Recorded for grouting works to ensure consistency with specification."
    },
    "seal_depth": {
      "type": "number",
      "description": "Depth in metres to which a borehole was sealed/backfilled during decommissioning. Used with backfill_material to record the environmental seal."
    },
    "probe_depth": {
      "type": "number",
      "description": "Depth reached by geophysical probing (m). Used for geophysical_probing logs."
    },
    "sensor_type": {
      "type": "string",
      "description": "Type of sensor/probe used for geophysical probing (e.g. 'cone penetrometer', 'resistivity', 'MASW'). Used for geophysical_probing logs."
    },
    "site_passport_id": {
      "type": "string",
      "description": "Links this log to the Site Passport / Permit to Dig record \u2014 ensures work was permitted before the log could be created. Set automatically when the crew's briefing confirms PTD sign-off."
    },
    "manager_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "queried"
      ],
      "default": "pending",
      "description": "Manager review status. 'pending' = awaiting review, 'approved' = verified for reporting, 'queried' = flagged for investigation (anomalous data, missing mandatory fields, etc.)"
    },
    "manager_review_note": {
      "type": "string",
      "description": "Note from the manager when querying or approving this log entry"
    },
    "manager_reviewed_by": {
      "type": "string",
      "description": "Name of the manager who reviewed this log entry"
    },
    "manager_reviewed_at": {
      "type": "string",
      "description": "ISO timestamp of when the manager reviewed this log entry"
    },
    "chargeable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this investigation activity is chargeable to the client"
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule used to calculate the charge for this activity"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated charge amount in GBP (set by calculateCharge)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "auto",
        "no_charge",
        "custom_fee"
      ],
      "default": "auto",
      "description": "How the charge was determined. 'auto' = calculated from rule, 'no_charge' = explicitly not charged, 'custom_fee' = manual override."
    },
    "custom_fee": {
      "type": "number",
      "description": "Manual fee override in GBP \u2014 used when billing_status is 'custom_fee'"
    }
  },
  "required": [
    "job_id",
    "staff_id",
    "date",
    "log_type"
  ]
}
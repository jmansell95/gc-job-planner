{
  "name": "KeyLogBookConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret that KeyLogBook sends with each webhook payload to authenticate it. Enter this same value in your KeyLogBook webhook configuration. The webhook receiver validates every incoming request against this secret."
    },
    "api_base_url": {
      "type": "string",
      "description": "KeyLogBook REST API base URL (for future pull-based synchronisation). Leave blank if using webhooks only."
    },
    "api_key": {
      "type": "string",
      "description": "KeyLogBook API key / bearer token (for future pull-based synchronisation). Leave blank if using webhooks only."
    },
    "auto_generate_timesheets": {
      "type": "boolean",
      "default": true,
      "description": "When true, incoming KeyLogBook webhook data automatically creates draft timesheet entries for the lead driller and second man assigned to the job that day. The crew then reviews and submits them at the end of their shift."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the KeyLogBook real-time sync. When false, incoming webhooks are rejected even if the secret matches."
    },
    "last_webhook_at": {
      "type": "string",
      "description": "ISO timestamp of the last webhook payload received from KeyLogBook."
    },
    "last_webhook_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last webhook received \u2014 'success' = payload processed, 'failed' = validation or processing error, 'never' = no webhook received yet."
    },
    "last_webhook_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last webhook result (e.g. 'Processed 14 log entries \u00b7 2 timesheets drafted for BH-01 job')."
    },
    "ags_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the automated AGS file push sync. When true, KeyLogBook can push whole-job AGS files to the importAGS endpoint every 30 minutes using the ags_sync_secret for authentication."
    },
    "ags_sync_secret": {
      "type": "string",
      "description": "Shared secret (API key) that KeyLogBook sends in the Authorization header (Bearer token) when pushing AGS files to the importAGS endpoint. The import function validates this against the stored value before processing."
    },
    "ags_sync_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "How often KeyLogBook pushes an AGS file (in minutes). Displayed in the UI so the builder knows the expected cadence. Set by the KeyLogBook developer."
    },
    "last_ags_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last automated AGS file push received from KeyLogBook."
    },
    "last_ags_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last automated AGS push \u2014 'success' = file processed, 'failed' = auth or processing error, 'never' = no push received yet."
    },
    "last_ags_sync_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last AGS push result (e.g. 'Imported 42 log entries into Cambridge North job')."
    }
  },
  "required": [
    "key"
  ]
}
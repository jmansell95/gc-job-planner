{
  "name": "AssetPandaConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "api_token": {
      "type": "string",
      "description": "Asset Panda API bearer token. Obtained from the Asset Panda API Configuration page. If left blank and email/password are set, the sync will request a fresh token on each run."
    },
    "email": {
      "type": "string",
      "description": "Asset Panda account email \u2014 used to auto-generate a session token when api_token is blank."
    },
    "password": {
      "type": "string",
      "description": "Asset Panda account password \u2014 used with email to auto-generate a session token when api_token is blank."
    },
    "base_url": {
      "type": "string",
      "default": "https://api.assetpanda.com",
      "description": "Asset Panda REST API base URL."
    },
    "group_id": {
      "type": "string",
      "description": "Asset Panda group (entity) ID whose objects represent the inventory to sync. Find this in Asset Panda under the group's settings."
    },
    "field_name": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the asset name field key. Kept for backward compatibility; the custom field_map takes precedence."
    },
    "field_serial": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the serial / asset tag field key."
    },
    "field_daily_rate": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the daily billing rate field key."
    },
    "field_stock_status": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the stock / condition status field key."
    },
    "field_asset_type": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the asset type / category field key."
    },
    "field_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system_field": {
            "type": "string",
            "description": "The SiteAsset system field name to map to (e.g. 'name', 'serial_number', 'storage_location', 'compliance_expiry_date')."
          },
          "panda_field_key": {
            "type": "string",
            "description": "The Asset Panda field key (e.g. 'field_1') that holds the value for this system field."
          },
          "panda_field_label": {
            "type": "string",
            "description": "The human-readable label of the Asset Panda field (denormalised for display in the mapping UI)."
          }
        },
        "required": [
          "system_field",
          "panda_field_key"
        ]
      },
      "default": [],
      "description": "Full custom field map \u2014 maps any Asset Panda field to any SiteAsset system field. Configured visually in Settings \u2192 Asset Panda \u2192 Field Mapping. Takes precedence over the legacy fixed field_* mappings. The sync applies core fields (name, serial, type, stock, rate) with their specialised parsing, and applies all other mapped fields as direct copies."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret used to authenticate inbound webhooks from Asset Panda flows. Appended as the 'secret' query parameter on the webhook URL. When set, the assetPandaWebhook endpoint verifies every request carries this secret."
    },
    "auto_deactivate": {
      "type": "boolean",
      "default": true,
      "description": "When true, assets reported by Asset Panda as out of stock or needing service are automatically deactivated (is_active = false) so they can't be added to jobs."
    },
    "last_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful sync run."
    },
    "last_sync_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last sync result (counts, errors)."
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last sync attempt."
    }
  },
  "required": [
    "key"
  ]
}
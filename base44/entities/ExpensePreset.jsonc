{
  "name": "ExpensePreset",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Quick-add button label shown to crews (e.g. 'Fuel', 'Subsistence', 'Materials')"
    },
    "category": {
      "type": "string",
      "enum": [
        "fuel",
        "subsistence",
        "materials",
        "equipment_hire",
        "subcontractor",
        "misc",
        "tolls_parking",
        "travel"
      ],
      "description": "Expense category \u2014 drives SAP Concur GL code mapping"
    },
    "default_amount": {
      "type": "number",
      "description": "Default amount in GBP pre-filled when the crew taps this preset. 0 = no pre-fill (crew enters manually)."
    },
    "default_vat_rate": {
      "type": "number",
      "default": 20,
      "description": "Default VAT rate (%) pre-filled for this preset. 0 = zero-rated."
    },
    "description": {
      "type": "string",
      "description": "Default description text pre-filled when the crew taps this preset"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react (e.g. 'Fuel', 'Coffee', 'Package', 'Receipt'). Defaults to 'Receipt'."
    },
    "color": {
      "type": "string",
      "description": "Tailwind color key for the button (e.g. 'amber', 'blue', 'emerald', 'violet', 'slate'). Defaults to 'slate'."
    },
    "gl_code": {
      "type": "string",
      "description": "SAP Concur GL code mapped to this preset's category. Auto-assigned to DailyCost records created from this preset."
    },
    "job_type_filter": {
      "type": "string",
      "description": "Only show this preset on jobs of this type (blank = show on all jobs)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this preset is available on the mobile expense step"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = first in the quick-add grid)"
    }
  },
  "required": [
    "label",
    "category"
  ]
}
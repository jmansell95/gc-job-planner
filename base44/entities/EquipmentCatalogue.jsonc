{
  "name": "EquipmentCatalogue",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Item description (e.g. 'Excavator 5-ton', 'Transformer hire', 'Casing hire')"
    },
    "category": {
      "type": "string",
      "enum": [
        "hired_equipment",
        "purchased_equipment",
        "internal_equipment",
        "contractor_supplied"
      ],
      "default": "hired_equipment",
      "description": "Default category for this catalogue item \u2014 auto-fills when added to a job"
    },
    "default_supplier_id": {
      "type": "string",
      "description": "Default supplier for this item (optional)"
    },
    "default_unit_cost": {
      "type": "number",
      "description": "Default net cost per unit in GBP"
    },
    "default_unit_label": {
      "type": "string",
      "default": "day",
      "description": "Default unit label (day, hour, m, each)"
    },
    "default_vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is VAT exempt by default"
    },
    "reference_number": {
      "type": "string",
      "description": "Default reference / serial number (optional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this catalogue item is available for selection on jobs"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = first in dropdown)"
    }
  },
  "required": [
    "description",
    "default_unit_cost"
  ]
}
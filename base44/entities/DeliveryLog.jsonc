{
  "name": "DeliveryLog",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Job this delivery/collection is associated with"
    },
    "job_name": {
      "type": "string",
      "description": "Job name (for display)"
    },
    "driver_staff_id": {
      "type": "string",
      "description": "Staff member assigned to drive / carry out the delivery"
    },
    "driver_staff_name": {
      "type": "string",
      "description": "Driver name (for display)"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "site_delivery",
        "supplier_collection",
        "item_handover"
      ],
      "description": "Type of movement: delivering to site, collecting from supplier, or internal handover"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Delivery task status"
    },
    "items": {
      "type": "string",
      "description": "Comma-separated or free-text list of items being delivered/collected"
    },
    "linked_cost_item_ids": {
      "type": "string",
      "description": "Comma-separated IDs of JobCostItem groups linked to this delivery \u2014 used to auto-populate items and track which material sets are on this load"
    },
    "pickup_address": {
      "type": "string",
      "description": "Where to collect/pick up the items from (supplier yard, depot, etc.)"
    },
    "delivery_address": {
      "type": "string",
      "description": "Where items are being delivered to (site address, supplier return, etc.)"
    },
    "contact_name": {
      "type": "string",
      "description": "On-site or supplier contact name for handover"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number for the delivery/collection point"
    },
    "po_number": {
      "type": "string",
      "description": "Purchase order / reference number for this delivery"
    },
    "linked_cost_item_id": {
      "type": "string",
      "description": "Optional linked JobCostItem for automatic cost tracking updates"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the delivery/collection is scheduled for"
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the driver started the delivery task"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp when the delivery was signed off"
    },
    "signature_url": {
      "type": "string",
      "description": "URL of the uploaded recipient signature image (PNG)"
    },
    "signature_data_url": {
      "type": "string",
      "description": "Base64 data URL of the signature \u2014 used for offline storage, cleared after sync"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Name of the person who signed for the delivery"
    },
    "photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of condition/evidence photos"
    },
    "photo_data_urls": {
      "type": "string",
      "description": "Comma-separated base64 data URLs of photos \u2014 used for offline storage, cleared after sync"
    },
    "gps_coordinates": {
      "type": "string",
      "description": "Lat/lng captured at time of completion (e.g. '51.5074,-0.1278')"
    },
    "notes": {
      "type": "string",
      "description": "Driver notes about the delivery/collection (damage, delays, access issues)"
    },
    "condition_report": {
      "type": "string",
      "description": "Condition of equipment upon delivery or collection (good, damaged, missing parts, etc.)"
    },
    "synced_from_offline": {
      "type": "boolean",
      "default": false,
      "description": "True if this delivery was signed off while offline and synced later"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle used for this delivery"
    },
    "weight_kg": {
      "type": "number",
      "description": "Weight of this delivery's items in kg \u2014 used for vehicle capacity checks. Manager-only field."
    },
    "volume_m3": {
      "type": "number",
      "description": "Volume of this delivery's items in cubic metres \u2014 used for vehicle capacity checks. Manager-only field."
    },
    "chargeable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this delivery is chargeable to the client. All drives are chargeable by default; toggle off for goodwill/free visits. Internal handovers (item_handover) default to not chargeable."
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule used to calculate the charge for this delivery"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated charge amount in GBP (set by the calculateCharge function)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated (rule name, method, components)"
    },
    "miles": {
      "type": "number",
      "description": "Round-trip miles driven for this delivery \u2014 used for per-mile charge calculations"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "auto",
        "no_charge",
        "custom_fee"
      ],
      "default": "auto",
      "description": "How the charge was determined. 'auto' = calculated from rule, 'no_charge' = explicitly not charged, 'custom_fee' = manual override amount."
    },
    "custom_fee": {
      "type": "number",
      "description": "Manual fee override in GBP \u2014 used when billing_status is 'custom_fee'"
    },
    "handover_to_staff_id": {
      "type": "string",
      "description": "Staff member the driver handed the items over to (instead of delivering to the site recipient). Set when a driver uses the handover-to-colleague flow. The chained delivery created for this colleague carries parent_delivery_id pointing back here."
    },
    "handover_to_staff_name": {
      "type": "string",
      "description": "Name of the colleague the items were handed over to (denormalised for display)."
    },
    "handover_from_staff_name": {
      "type": "string",
      "description": "Name of the driver who handed the items over. Set on the chained (child) delivery so the receiving colleague can see who handed it to them."
    },
    "parent_delivery_id": {
      "type": "string",
      "description": "ID of the original delivery this was handed over from. Set on chained (child) deliveries created by the handover flow \u2014 links the chain so the admin hub can show the full movement history of an item."
    },
    "handover_completed_at": {
      "type": "string",
      "description": "ISO timestamp when the handover was confirmed by the receiving colleague (their sign-off)."
    }
  },
  "required": [
    "job_id",
    "driver_staff_id",
    "delivery_type",
    "scheduled_date"
  ]
}
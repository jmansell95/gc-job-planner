{
  "name": "DashboardLayout",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member this dashboard layout belongs to"
    },
    "widget_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of all known widget IDs (visible + hidden). Controls the drag-and-drop arrangement of widgets on the dashboard."
    },
    "hidden_widgets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Widget IDs that are currently hidden via the Customize panel. These stay in widget_order so their position is preserved when toggled back on, but are not rendered."
    },
    "widget_sizes": {
      "type": "object",
      "description": "Map of widget ID to size ('sm', 'md', 'lg'). Controls how many grid columns each widget spans on large screens. 'sm' = half width, 'md' = half width (default), 'lg' = full width. Stored so each user's sizing preference persists across logins."
    }
  },
  "required": [
    "staff_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
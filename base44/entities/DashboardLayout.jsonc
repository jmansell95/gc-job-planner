{
  "name": "DashboardLayout",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member this dashboard layout belongs to"
    },
    "widget_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of visible widget IDs. Widgets not in this list are hidden."
    },
    "widget_sizes": {
      "type": "object",
      "description": "Map of widget ID to size ('sm', 'md', 'lg'). Controls how many grid columns each widget spans on large screens."
    }
  },
  "required": [
    "staff_id"
  ]
}
{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member"
    },
    "job_id": {
      "type": "string",
      "description": "Job worked on. Empty for break entries."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date worked"
    },
    "task_description": {
      "type": "string",
      "description": "What the staff member was doing (e.g. setting up the rig, putting up heras fencing). 'Break' for break entries."
    },
    "task_duration_minutes": {
      "type": "number",
      "description": "How long the task took in minutes"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM) \u2014 optional, used by legacy time-based entries"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM) \u2014 optional, used by legacy time-based entries"
    },
    "break_minutes": {
      "type": "number",
      "default": 30,
      "description": "Break duration in minutes"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked (calculated from task duration or start/end times)"
    },
    "meterage": {
      "type": "number",
      "description": "Meters drilled (if applicable)"
    },
    "notes": {
      "type": "string",
      "description": "Timesheet notes"
    },
    "is_break": {
      "type": "boolean",
      "default": false,
      "description": "True for break entries. Breaks count toward the day total but NOT toward any job's time or cost."
    },
    "is_overtime": {
      "type": "boolean",
      "default": false,
      "description": "True when the staff member explicitly logged this task as overtime. The whole entry is paid at the overtime rate for its day, regardless of the weekly threshold."
    },
    "rate_multiplier": {
      "type": "number",
      "description": "Pay multiplier inherited from the rota assignment (e.g. 1.5 = time-and-a-half). Used when is_overtime is true; overrides the default day-of-week rate."
    },
    "task_type": {
      "type": "string",
      "enum": [
        "on_site",
        "travel_to",
        "travel_from"
      ],
      "default": "on_site",
      "description": "Type of work entry. 'on_site' = normal task, 'travel_to' = travelling to site, 'travel_from' = travelling home from site."
    },
    "is_summary": {
      "type": "boolean",
      "default": false,
      "description": "True for merged daily summary entries created by submitDailyTimesheet. These are what managers approve."
    },
    "summary_entry_ids": {
      "type": "string",
      "description": "Comma-separated IDs of the granular entries merged into this summary"
    },
    "on_site_minutes": {
      "type": "number",
      "description": "For summary entries: total on-site work minutes (excludes breaks and travel)"
    },
    "travel_to_minutes": {
      "type": "number",
      "description": "For summary entries: total travel-to-site minutes"
    },
    "travel_from_minutes": {
      "type": "number",
      "description": "For summary entries: total travel-from-site minutes"
    },
    "payable_travel_minutes": {
      "type": "number",
      "description": "For summary entries: travel minutes payable after the 1.5h deductible (0 for depot teams or travel under 1.5h)"
    },
    "travel_depart_home": {
      "type": "string",
      "description": "Time departed home (HH:MM) \u2014 from the travel_to entry"
    },
    "travel_arrive_site": {
      "type": "string",
      "description": "Time arrived on site (HH:MM) \u2014 from the travel_to entry"
    },
    "travel_depart_site": {
      "type": "string",
      "description": "Time departed site (HH:MM) \u2014 from the travel_from entry"
    },
    "travel_arrive_home": {
      "type": "string",
      "description": "Time arrived home (HH:MM) \u2014 from the travel_from entry"
    },
    "approved_by_name": {
      "type": "string",
      "description": "Name of the manager who approved this timesheet"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "deleted",
        "merged"
      ],
      "default": "submitted",
      "description": "Timesheet approval status. 'draft' = still being edited, 'submitted' = awaiting approval, 'approved'/'rejected' = manager decision, 'deleted' = withdrawn by staff, 'merged' = granular entry merged into a daily summary (no longer individually approvable)."
    },
    "deletion_reason": {
      "type": "string",
      "description": "Reason given by staff when withdrawing/deleting a submitted timesheet (visible to manager & admin)"
    },
    "deleted_at": {
      "type": "string",
      "description": "ISO timestamp when the timesheet was withdrawn"
    },
    "withdrawal_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether the manager has acknowledged this staff withdrawal"
    },
    "withdrawal_acknowledged_by": {
      "type": "string",
      "description": "Name of the manager who acknowledged the withdrawal"
    },
    "withdrawal_acknowledged_at": {
      "type": "string",
      "description": "ISO timestamp when the withdrawal was acknowledged"
    },
    "chargeable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this task is chargeable to the client. Set to true by the system when a matching BillingRule is found."
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule that matched this task description \u2014 used to calculate the client charge"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated client charge in GBP for this task (set by calculateCharge)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated"
    }
  },
  "required": [
    "staff_id",
    "date"
  ]
}
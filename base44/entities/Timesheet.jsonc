{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member"
    },
    "job_id": {
      "type": "string",
      "description": "Job worked on"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date worked"
    },
    "task_description": {
      "type": "string",
      "description": "What the staff member was doing (e.g. setting up the rig, putting up heras fencing)"
    },
    "task_duration_minutes": {
      "type": "number",
      "description": "How long the task took in minutes"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM) \u2014 optional, used by legacy time-based entries"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM) \u2014 optional, used by legacy time-based entries"
    },
    "break_minutes": {
      "type": "number",
      "default": 30,
      "description": "Break duration in minutes"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked (calculated from task duration or start/end times)"
    },
    "meterage": {
      "type": "number",
      "description": "Meters drilled (if applicable)"
    },
    "notes": {
      "type": "string",
      "description": "Timesheet notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "Timesheet approval status"
    }
  },
  "required": [
    "staff_id",
    "job_id",
    "date"
  ]
}
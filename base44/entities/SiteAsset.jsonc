{
  "name": "SiteAsset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Asset name (e.g. 'Truck-mounted Rig 1', 'Trailer T-03', 'Excavator CAT 320')"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "rig",
        "machinery",
        "trailer",
        "vehicle",
        "lifting"
      ],
      "description": "Type of asset \u2014 'lifting' covers lifting gear (shackles, slings, chains, hooks) linked to rigs"
    },
    "equipment_type": {
      "type": "string",
      "description": "Equipment type/category pulled from GC Compliance Manager (e.g. 'Overshot Tool', 'Sling', 'Shackle'). More specific than asset_type."
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "n/a"
      ],
      "default": "n/a",
      "description": "Drilling rig type \u2014 CP (cable percussion) or Rotary. Only set when asset_type is 'rig'."
    },
    "is_rig": {
      "type": "boolean",
      "default": false,
      "description": "True when this asset is a drilling rig (CP or Rotary). Used to decouple rig assignment (handled via the dedicated rig flow) from general owned-equipment selection on jobs. Set automatically by the Asset Panda sync based on the asset type / category."
    },
    "serial_number": {
      "type": "string",
      "description": "Serial number, asset tag or registration"
    },
    "external_compliance_id": {
      "type": "string",
      "description": "ID of this asset in the GC Compliance Manager app \u2014 used to cross-reference compliance records"
    },
    "panda_asset_id": {
      "type": "string",
      "description": "ID of this asset in Asset Panda \u2014 used by the scheduled sync to match inventory records and pull live stock levels and warehouse locations."
    },
    "daily_billing_rate": {
      "type": "number",
      "description": "DEPRECATED \u2014 do not use for billing. Asset Panda is for inventory stock levels and warehouse locations only, not pricing. All rig, crew, plant and labour prices come from the Master Price List (RateCardItem) via the rate card matcher. This field is retained for backward compatibility only."
    },
    "stock_level": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock",
        "needs_service",
        "unknown"
      ],
      "default": "unknown",
      "description": "Live stock/condition quality from Asset Panda. 'needs_service' or 'out_of_stock' items are auto-deactivated and cannot be added to jobs."
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Last Asset Panda sync outcome. 'synced' = latest data pulled, 'pending' = queued, 'failed' = last sync errored, 'never' = not yet synced."
    },
    "last_sync_timestamp": {
      "type": "string",
      "description": "ISO timestamp of the last successful Asset Panda sync for this asset."
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "expiring",
        "expired",
        "unknown"
      ],
      "default": "unknown",
      "description": "Current compliance status. Synced from the GC Compliance Manager app \u2014 admins update this when compliance changes."
    },
    "compliance_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Date the asset's compliance expires (from GC Compliance Manager)"
    },
    "compliance_last_checked": {
      "type": "string",
      "description": "ISO timestamp of when the compliance status was last synced from GC Compliance Manager"
    },
    "responsible_person": {
      "type": "string",
      "description": "Person responsible for this asset (synced from GC Compliance Manager)"
    },
    "tooling_notes": {
      "type": "string",
      "description": "Associated tooling for this rig/equipment (e.g. casing sizes, augers, core barrels)"
    },
    "linked_equipment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of SiteAsset equipment (lifting gear, machinery, trailers) linked to this rig \u2014 shown when assigning the rig to a job for quick bulk assignment"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is available for job assignment. Automatically set to false when Asset Panda reports it out of stock or needing service."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this asset"
    }
  },
  "required": [
    "name",
    "asset_type"
  ]
}
{
  "name": "InvestigationSOR",
  "type": "object",
  "properties": {
    "sheet_name": {
      "type": "string",
      "enum": [
        "CP Standard",
        "CP Cutdown",
        "Rotary Drilling & Coring",
        "Sonic Drilling & Coring",
        "Dynamic Sampling"
      ],
      "description": "Which SOR sheet/tab this rate item belongs to \u2014 drives the tabbed UI in the Rate Card Manager."
    },
    "section": {
      "type": "string",
      "description": "Section letter from the SOR (e.g. 'A', 'B', 'C'). Groups items under major headings."
    },
    "section_heading": {
      "type": "string",
      "description": "Full section heading text (e.g. 'GENERAL ITEMS, PROVISIONAL SERVICES AND ADDITIONAL ITEMS', 'PERCUSSIVE BORING')."
    },
    "item_ref": {
      "type": "string",
      "description": "Item reference number from the SOR (e.g. '2', '2.1', '3.1')."
    },
    "description": {
      "type": "string",
      "description": "Item description as it appears on the schedule of rates."
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (e.g. 'sum', 'm', 'nr', 'day', 'hour', 'each')."
    },
    "price": {
      "type": "number",
      "description": "Net price in GBP for the active year. Null when the price is not a simple number (POA, 'nr', etc.)."
    },
    "price_text": {
      "type": "string",
      "description": "Raw price text when the price is not a simple number (e.g. 'POA', 'nr', 'included')."
    },
    "year": {
      "type": "number",
      "default": 2026,
      "description": "The calendar year these rates are active for. The 2026 uplift column from the uploaded SOR."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the sheet (preserves the original SOR row sequence)."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rate is current and available for use."
    }
  },
  "required": [
    "sheet_name",
    "description"
  ]
}
{
  "name": "HotelBooking",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "DEPRECATED \u2014 legacy single-staff field. Use assigned_staff_ids instead."
    },
    "staff_name": {
      "type": "string",
      "description": "DEPRECATED \u2014 legacy single-staff display name. Use assigned_staff_names instead."
    },
    "assigned_staff_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff member IDs assigned to this hotel booking for the job"
    },
    "assigned_staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff member names (for display)"
    },
    "job_id": {
      "type": "string",
      "description": "Job this hotel booking is associated with"
    },
    "job_name": {
      "type": "string",
      "description": "Job name (for display)"
    },
    "hotel_name": {
      "type": "string",
      "description": "Name of the hotel"
    },
    "address": {
      "type": "string",
      "description": "Hotel address"
    },
    "check_in_date": {
      "type": "string",
      "format": "date",
      "description": "Check-in date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date",
      "description": "Check-out date"
    },
    "booking_reference": {
      "type": "string",
      "description": "Booking confirmation / reference number"
    },
    "room_type": {
      "type": "string",
      "description": "Room type (e.g. Single, Twin, Double)"
    },
    "contact_phone": {
      "type": "string",
      "description": "Hotel contact phone number"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes (e.g. parking, breakfast included)"
    }
  },
  "required": [
    "job_id",
    "hotel_name"
  ]
}
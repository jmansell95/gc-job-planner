{
  "name": "AFP",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "The job this Application for Payment belongs to. Multiple AFPs per job \u2014 one per monthly period, chained from job start to completion."
    },
    "job_name": {
      "type": "string",
      "description": "Job name (denormalised for display)."
    },
    "job_reference": {
      "type": "string",
      "description": "Job reference / GC job number (denormalised for display)."
    },
    "division_id": {
      "type": "string",
      "description": "The division this AFP belongs to (denormalised from the job). Drives division-scoped filtering."
    },
    "afp_number": {
      "type": "number",
      "default": 1,
      "description": "Sequential AFP number per job (1 = first AFP, 2 = second, etc.). Auto-assigned when the next AFP is created on submission."
    },
    "period_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy billing period date. Superseded by period_start_date / period_end_date for the live AFP lifecycle, but retained for backward compatibility with uploaded AFPs."
    },
    "period_start_date": {
      "type": "string",
      "format": "date",
      "description": "The start date of this AFP's billing period. For the first AFP, this is the job start date. For subsequent AFPs, this is the day after the previous AFP's period_end_date."
    },
    "period_end_date": {
      "type": "string",
      "format": "date",
      "description": "The submission deadline \u2014 the date by which this AFP MUST be sent to the client to remain legally protected. Records up to this date go in this AFP. Set by the billing team per AFP (per-AFP flexible)."
    },
    "certification_due_date": {
      "type": "string",
      "format": "date",
      "description": "The date by which the client must certify what they are willing to pay. Auto-calculated as period_end_date + 5 days, but fully editable. This is the 'when the client sends us what they are willing to pay' date."
    },
    "final_payment_notice_date": {
      "type": "string",
      "format": "date",
      "description": "The last date the client can possibly pay for these works. Auto-calculated as period_end_date + 30 days (30 days from when we submit the AFP), but fully editable. If we have sent the AFP by the correct date but received nothing from the client since, accounts issue a default invoice after this date."
    },
    "next_afp_id": {
      "type": "string",
      "description": "ID of the next AFP in the chain. Set when this AFP is submitted to the client \u2014 the system auto-creates the next AFP with period_start = this AFP's period_end + 1 day."
    },
    "client_po": {
      "type": "string",
      "description": "Client purchase order number. Pulled from the AFP 'Client Purchase Order' field (e.g. '26/4168')."
    },
    "gc_job_number": {
      "type": "string",
      "description": "GC internal job number. Pulled from the AFP 'GC Job Number' field (e.g. 'I260236')."
    },
    "client_name": {
      "type": "string",
      "description": "Client company name. Pulled from the AFP 'Client' field (e.g. 'Concept SI')."
    },
    "contract_value": {
      "type": "number",
      "description": "Contract award value for this AFP. Pulled from the AFP 'Contract award value' field."
    },
    "total_claimed": {
      "type": "number",
      "default": 0,
      "description": "Total amount claimed in this AFP = sum of all AFPLineItem amounts. Auto-calculated."
    },
    "original_total": {
      "type": "number",
      "default": 0,
      "description": "The original total before any client disputes. Captured at the time of submission to the client. Equals sum of all line item original amounts."
    },
    "disputed_total": {
      "type": "number",
      "default": 0,
      "description": "The total value of items currently in dispute (disputed + counter-offered statuses). Auto-calculated from line item dispute statuses."
    },
    "agreed_total": {
      "type": "number",
      "default": 0,
      "description": "The final agreed total after all disputes are resolved. Equals sum of agreed/undisputed line item amounts. This is the amount pushed to the CVR."
    },
    "dispute_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "resolved"
      ],
      "default": "none",
      "description": "Per-AFP dispute roll-up. 'none' = no disputes (draft or all items undisputed); 'active' = one or more items disputed/counter-offered; 'resolved' = all disputes resolved (all items agreed or rejected)."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "invoiced"
      ],
      "default": "draft",
      "description": "AFP lifecycle. 'draft' = being prepared/populated with live field data; 'submitted' = sent to client for approval (disputes can occur); 'approved' = client approved all items; 'invoiced' = pushed to CVR and converted to formal invoice."
    },
    "client_facing_pdf_url": {
      "type": "string",
      "description": "URL of the generated client-facing PDF. Created when the AFP is submitted to the client."
    },
    "pushed_to_cvr_at": {
      "type": "string",
      "description": "ISO timestamp when the AFP was pushed to the CVR."
    },
    "pushed_by": {
      "type": "string",
      "description": "Name of the user who pushed the AFP to the CVR."
    },
    "last_populated_at": {
      "type": "string",
      "description": "ISO timestamp of the last 'Refresh from Field Data' run that populated this AFP's line items from daily field records."
    },
    "last_populated_by": {
      "type": "string",
      "description": "Name of the user who last triggered the field data population."
    },
    "source_file_url": {
      "type": "string",
      "description": "URL of the uploaded AFP Excel file (for AFPs imported via the Excel upload flow)."
    },
    "source_file_name": {
      "type": "string",
      "description": "Original filename of the uploaded AFP Excel file."
    },
    "last_updated_at": {
      "type": "string",
      "description": "ISO timestamp of the last upload or in-app edit."
    },
    "last_updated_by": {
      "type": "string",
      "description": "Name of the user who last uploaded or edited the AFP."
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
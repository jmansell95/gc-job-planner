{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform access role. 'admin' = Super Admin (full platform bypass including user management and all app data), 'user' = standard authenticated user (app-level access is controlled by their linked Staff record's system_role)."
    }
  }
}
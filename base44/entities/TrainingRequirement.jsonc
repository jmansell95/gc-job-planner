{
  "name": "TrainingRequirement",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Full display label for this training/qualification category (e.g. 'CSCS Card', 'First Aid Certificate', 'Confined Space Training')."
    },
    "short_code": {
      "type": "string",
      "description": "Short code shown in the matrix column header (e.g. 'CSCS', 'FA', 'CS'). Keep it 2-4 characters."
    },
    "qualification_type": {
      "type": "string",
      "description": "The qualification type key. Must match ComplianceItem.qualification_type and TrainingCourse.category values. Use a standard key for built-in types (cscs_card, cpcs_card, npors_card, first_aid_cert, driver_license, dbs_certificate, forklift) or a custom key for new training types (e.g. confined_space, working_at_height)."
    },
    "requires_front_back": {
      "type": "boolean",
      "default": false,
      "description": "True for card-type credentials that need front/back image uploads (CSCS, CPCS, NPORS, Driver License). The compliance editor shows a back-of-card upload field when this is true."
    },
    "is_card": {
      "type": "boolean",
      "default": false,
      "description": "True for card-type credentials (CSCS, CPCS, NPORS, Driver License) \u2014 these are displayed as visual flip-cards in the Compliance Wallet. Certificate-type items are displayed as document thumbnails."
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for this category (e.g. 'IdCard', 'ShieldCheck', 'Award', 'Car'). Used in the matrix and wallet UI."
    },
    "color": {
      "type": "string",
      "description": "Accent colour for this category in the matrix and wallet (hex, e.g. '#2E5A1A'). Optional \u2014 defaults to brand green."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the training matrix (lower = first column)."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is shown in the training matrix. Inactive categories are hidden but retained for historical data."
    }
  },
  "required": [
    "label",
    "short_code",
    "qualification_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
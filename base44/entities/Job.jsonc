{
  "name": "Job",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Job name"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project \u2014 groups multiple jobs (e.g. 5 jobs across 2 sites) under one parent project. Blank for standalone jobs."
    },
    "job_reference": {
      "type": "string",
      "description": "Internal job reference or PO number"
    },
    "location": {
      "type": "string",
      "description": "Site location/address"
    },
    "site_lat": {
      "type": "number",
      "description": "Job site latitude (for Geotab GPS geofencing \u2014 auto-detects arrival/departure times for timesheets). Set manually or via the geocode button on the job form."
    },
    "site_lng": {
      "type": "number",
      "description": "Job site longitude (for Geotab GPS geofencing \u2014 auto-detects arrival/departure times for timesheets). Set manually or via the geocode button on the job form."
    },
    "job_type": {
      "type": "string",
      "description": "Job type key \u2014 matches the key field of a JobType record (e.g. groundworks, cp_drilling). Managed via Settings \u2192 Job Types. Falls back to the first required team's job_type when not set."
    },
    "required_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Teams required for this job. Staff outside these teams can still be assigned but managers see a soft warning. Derived from the legacy job_type during migration."
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "decommissioning",
        "completed",
        "on_hold",
        "cancelled"
      ],
      "default": "planning",
      "description": "Job status. New jobs start in 'planning', automatically move to 'in_progress' when the rota is published, then to 'decommissioning' when work finishes and equipment is being collected, and finally 'completed' once all items are returned."
    },
    "status_reason": {
      "type": "string",
      "description": "Reason recorded when a job is put on hold or cancelled"
    },
    "status_changed_at": {
      "type": "string",
      "description": "ISO timestamp of the last manual status change (on hold, cancelled, completed, or reactivated)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Job start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Job end date"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client"
    },
    "contractor_id": {
      "type": "string",
      "description": "Associated contractor"
    },
    "project_manager": {
      "type": "string",
      "description": "Project manager responsible for the job"
    },
    "site_contact_name": {
      "type": "string",
      "description": "On-site contact name"
    },
    "site_contact_phone": {
      "type": "string",
      "description": "On-site contact phone number"
    },
    "notes": {
      "type": "string",
      "description": "Job notes and details"
    },
    "requisition_list_url": {
      "type": "string",
      "description": "URL of the uploaded requisition/equipment list file"
    },
    "requisition_list_name": {
      "type": "string",
      "description": "Original filename of the requisition list"
    },
    "portal_token": {
      "type": "string",
      "description": "Unique token for client portal access"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether client portal access is enabled for this job"
    },
    "portal_sections": {
      "type": "object",
      "description": "Visibility flags for each section shown on the client portal",
      "properties": {
        "progress": {
          "type": "boolean",
          "default": true
        },
        "client_info": {
          "type": "boolean",
          "default": true
        },
        "schedule": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "boolean",
          "default": true
        },
        "photos": {
          "type": "boolean",
          "default": true
        },
        "milestones": {
          "type": "boolean",
          "default": true
        },
        "documents": {
          "type": "boolean",
          "default": true
        },
        "comments": {
          "type": "boolean",
          "default": true
        },
        "team": {
          "type": "boolean",
          "default": true
        },
        "client_charge": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "budget_amount": {
      "type": "number",
      "description": "Job budget in GBP for cost tracking"
    },
    "actual_cost": {
      "type": "number",
      "description": "Manually recorded actual cost in GBP; overrides the auto-calculated labour cost when set"
    },
    "meterage": {
      "type": "number",
      "description": "Total meters drilled for drilling jobs (CP / rotary); overrides shift-level meterage for costing when set"
    },
    "meterage_rate": {
      "type": "number",
      "description": "Per-metre charge rate in GBP. When set, meterage revenue = total metres drilled \u00d7 this rate. Used for jobs billed on meterage instead of crew day rates."
    },
    "meterage_target": {
      "type": "number",
      "description": "Target total metres to drill for this job. Used to track progress and completion percentage against the agreed scope."
    },
    "drilling_method": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "mixed",
        "not_applicable"
      ],
      "default": "not_applicable",
      "description": "Primary drilling method for this job \u2014 'cp' = cable percussion, 'rotary' = rotary drilling, 'mixed' = both methods on the same job, 'not_applicable' = non-drilling (groundworks, EV chargers). Used to auto-match per-metre drilling rates from the correct rate card section (CP Drilling vs Rotary Drilling subcategories) and to tag each borehole's revenue by method. When left as 'not_applicable' but rigs are assigned, the engine auto-detects from rig_type."
    },
    "revenue_method": {
      "type": "string",
      "enum": [
        "none",
        "day_rate",
        "meterage_rate",
        "unit_rate",
        "flat_fee"
      ],
      "default": "none",
      "description": "How revenue is calculated for this job. 'none' = legacy markup-on-cost model (internal cost + markup %). 'day_rate' = sum of assigned crew day rates \u00d7 working days (from the schedule of rates). 'meterage_rate' = total metres drilled \u00d7 meterage_rate. 'unit_rate' = units completed \u00d7 unit_price. 'flat_fee' = single agreed project fee (client_charge). Set per job since billing terms vary \u2014 one drilling job may be day-rated while another is meteraged."
    },
    "unit_price": {
      "type": "number",
      "description": "Price per unit in GBP for unit-rate billing (e.g. \u00a3/trial pit, \u00a3/core run, \u00a3/EV charger installed). Used when revenue_method is 'unit_rate'. Revenue = units completed \u00d7 this price."
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Markup percentage applied to total internal net cost to derive the client price (used when revenue_method is 'none' or as a fallback)."
    },
    "vat_rate": {
      "type": "number",
      "default": 20,
      "description": "VAT rate (%) applied for billing calculations. UK standard rate is 20."
    },
    "client_charge": {
      "type": "number",
      "description": "Legacy manual client charge. Superseded by the calculated billing when cost items/markup are used. Also used as the flat fee when revenue_method is 'flat_fee'."
    },
    "client_charge_description": {
      "type": "string",
      "description": "Label shown alongside the client billing total on the portal (e.g. 'Agreed quote', 'Project Investment')"
    }
  },
  "required": [
    "name",
    "location",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
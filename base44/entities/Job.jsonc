{
  "name": "Job",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Job name"
    },
    "location": {
      "type": "string",
      "description": "Site location/address"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "groundworks",
        "cp_drilling",
        "rotary_drilling",
        "enabling_works",
        "depot"
      ],
      "description": "Type of job"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "completed",
        "on_hold"
      ],
      "default": "planning",
      "description": "Job status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Job start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Job end date"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client"
    },
    "contractor_id": {
      "type": "string",
      "description": "Associated contractor"
    },
    "notes": {
      "type": "string",
      "description": "Job notes and details"
    },
    "requisition_list_url": {
      "type": "string",
      "description": "URL of the uploaded requisition/equipment list file"
    },
    "requisition_list_name": {
      "type": "string",
      "description": "Original filename of the requisition list"
    },
    "portal_token": {
      "type": "string",
      "description": "Unique token for client portal access"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether client portal access is enabled for this job"
    },
    "budget_amount": {
      "type": "number",
      "description": "Job budget in GBP for cost tracking"
    }
  },
  "required": [
    "name",
    "location",
    "job_type",
    "start_date",
    "end_date"
  ]
}
{
  "name": "TradingEntity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Trading entity name (e.g. 'Ground Control Ltd', 'GC Drilling Services Ltd'). Shown in branding, email banners, and document headers."
    },
    "legal_name": {
      "type": "string",
      "description": "Full legal registered company name (e.g. 'Ground Control Geotechnical Limited')."
    },
    "company_registration_number": {
      "type": "string",
      "description": "Companies House registration number."
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number for this trading entity."
    },
    "address": {
      "type": "string",
      "description": "Registered office address."
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email for this entity."
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone number."
    },
    "logo_url": {
      "type": "string",
      "description": "URL of this entity's logo. Used in email banners, portal branding, and document headers for white-labeled output."
    },
    "primary_color": {
      "type": "string",
      "default": "#2E5A1A",
      "description": "Brand primary color (hex) for this entity. Used to white-label the client portal, email templates, and PDF reports."
    },
    "accent_color": {
      "type": "string",
      "default": "#8DC63F",
      "description": "Brand accent color (hex) for this entity."
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "True for the primary/default trading entity. Used when no specific entity is selected on a job or document."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this trading entity is currently active. Inactive entities can't be assigned to new jobs."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
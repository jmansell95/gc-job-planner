{
  "name": "EmailAlertSetting",
  "type": "object",
  "properties": {
    "alert_key": {
      "type": "string",
      "enum": [
        "vehicle_maintenance",
        "compliance_expiry",
        "assignment_notification",
        "staff_schedule",
        "staff_invitation",
        "absence_request",
        "job_status_change",
        "new_job",
        "timesheet_submitted",
        "maintenance_booking",
        "training_booking",
        "training_request",
        "daily_reminder",
        "daily_standup",
        "timesheet_summary",
        "milestone_push",
        "auto_invoice_digest"
      ],
      "description": "Which automated alert this configures"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this alert is active"
    },
    "recipient_emails": {
      "type": "string",
      "description": "Comma-separated recipient emails (blank = all admins)"
    },
    "days_before_warning": {
      "type": "number",
      "description": "Days before due date to warn (vehicle maintenance, compliance expiry)"
    },
    "subject": {
      "type": "string",
      "description": "Custom email subject line"
    },
    "intro_message": {
      "type": "string",
      "description": "Custom intro paragraph prepended to the default email body"
    },
    "template": {
      "type": "string",
      "description": "Full custom email body template with placeholders. Blank uses the default template."
    },
    "accent_color": {
      "type": "string",
      "default": "#0e7a4f",
      "description": "Hex colour used for the email banner and accents"
    },
    "banner_title": {
      "type": "string",
      "default": "GC Job Planner",
      "description": "Title shown in the email banner header"
    },
    "show_banner": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the coloured banner at the top of the email"
    },
    "footer_text": {
      "type": "string",
      "default": "GC Job Planner",
      "description": "Text shown in the email footer"
    }
  },
  "required": [
    "alert_key"
  ]
}
{
  "name": "EmailAlertSetting",
  "type": "object",
  "properties": {
    "alert_key": {
      "type": "string",
      "enum": [
        "vehicle_maintenance",
        "assignment_notification"
      ],
      "description": "Which automated alert this configures"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this alert is active"
    },
    "recipient_emails": {
      "type": "string",
      "description": "Comma-separated recipient emails (blank = all admins)"
    },
    "days_before_warning": {
      "type": "number",
      "description": "Days before due date to warn (vehicle maintenance)"
    },
    "subject": {
      "type": "string",
      "description": "Custom email subject line"
    },
    "intro_message": {
      "type": "string",
      "description": "Custom intro paragraph prepended to email body"
    }
  },
  "required": [
    "alert_key"
  ]
}
{
  "name": "BusinessConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "required_daily_on_site_minutes": {
      "type": "number",
      "default": 540,
      "description": "Minimum on-site working minutes required for a full day before an early-leave reason is needed. 540 = 9 hours. Drives the validation in the daily timesheet submission flow."
    },
    "travel_deductible_minutes": {
      "type": "number",
      "default": 90,
      "description": "Travel time (minutes) deducted from each leg of travel (to-site and from-site) before it becomes payable. 90 = 1.5 hours per leg. Depot teams are exempt from this deduction."
    }
  },
  "required": [
    "key"
  ]
}
{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "Job",
        "Staff",
        "SiteAsset",
        "Vehicle",
        "Client",
        "Supplier",
        "Contractor"
      ],
      "description": "Which entity this custom field belongs to. The field will appear on that entity's create/edit forms."
    },
    "field_key": {
      "type": "string",
      "description": "Machine-readable field key (snake_case). Used as the JSON property name when storing the value on the entity record."
    },
    "field_label": {
      "type": "string",
      "description": "Human-readable label shown on forms and in lists."
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "boolean",
        "select",
        "textarea"
      ],
      "default": "text",
      "description": "Input type for this custom field. 'select' uses the options array for dropdown values."
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Dropdown options for 'select' type fields. Ignored for other field types."
    },
    "default_value": {
      "type": "string",
      "description": "Default value applied when a new record is created without specifying this field. Stored as string; converted to the appropriate type by the form renderer."
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "True when this field must be filled in before saving the record."
    },
    "show_in_list": {
      "type": "boolean",
      "default": false,
      "description": "True when this field should appear as a column in list/table views for this entity."
    },
    "section": {
      "type": "string",
      "description": "Optional section heading to group this field under on the form (e.g. 'Site Specifics', 'Financial Details')."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the section. Lower numbers appear first."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "True when this field is visible on forms. Inactive fields are hidden but existing values are preserved."
    },
    "created_by_name": {
      "type": "string",
      "description": "Admin who created this custom field."
    }
  },
  "required": [
    "entity_type",
    "field_key",
    "field_label",
    "field_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Staff member full name"
    },
    "email": {
      "type": "string",
      "description": "Staff member email address"
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "direct_employee",
        "subcontractor",
        "agency"
      ],
      "description": "Type of worker"
    },
    "job_role": {
      "type": "string",
      "enum": [
        "groundworker",
        "cp_driller",
        "rotary_driller",
        "enabling_crew",
        "depot",
        "supervisor"
      ],
      "description": "Legacy job role \u2014 no longer used; team assignment drives job eligibility instead"
    },
    "team_id": {
      "type": "string",
      "description": "Team/group assignment \u2014 determines which jobs this staff member can be assigned to"
    },
    "default_vehicle_id": {
      "type": "string",
      "description": "Default vehicle assignment"
    },
    "drilling_crew_id": {
      "type": "string",
      "description": "Assigned drilling crew (if applicable)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether staff member is active"
    },
    "day_rate": {
      "type": "number",
      "description": "Daily rate in GBP for job cost calculations"
    },
    "meterage_rate": {
      "type": "number",
      "description": "Rate per meter in GBP for drilling staff (replaces day rate for drillers)"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account ID for login access"
    },
    "manager_id": {
      "type": "string",
      "description": "Staff member who approves this person's timesheets"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether an app invite email has been sent to this staff member"
    },
    "email_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this staff member receives automated schedule and assignment emails. When false, the system skips sending them weekly schedules, daily reminders, and assignment notifications."
    },
    "last_acknowledged_week": {
      "type": "string",
      "format": "date",
      "description": "Week start (Monday) of the last rota the staff member acknowledged via the schedule splash screen"
    },
    "schedule_acknowledged_at": {
      "type": "string",
      "description": "ISO timestamp of when the staff member last acknowledged their weekly schedule"
    }
  },
  "required": [
    "name",
    "email",
    "worker_type",
    "team_id"
  ]
}
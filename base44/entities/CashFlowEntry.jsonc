{
  "name": "CashFlowEntry",
  "type": "object",
  "properties": {
    "cvr_id": {
      "type": "string",
      "description": "The CVR this cash flow entry belongs to."
    },
    "job_id": {
      "type": "string",
      "description": "The job this cash flow entry belongs to (denormalised for direct job-level queries)."
    },
    "month_date": {
      "type": "string",
      "format": "date",
      "description": "The month this cash flow entry covers. Pulled from the Cash flow sheet's month column headers (e.g. 2025-10-31, 2025-11-30)."
    },
    "description": {
      "type": "string",
      "description": "Description of the cash flow line (e.g. 'App Value', 'Adjusted forecast value'). Pulled from the Cash flow sheet 'Item' / 'Description' column."
    },
    "app_value": {
      "type": "number",
      "description": "Application value for this month \u2014 the amount being claimed in the AFP for this period. Pulled from the Cash flow sheet monthly columns."
    },
    "qty": {
      "type": "number",
      "description": "Quantity for this cash flow line (if applicable)."
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure for this cash flow line."
    },
    "rate": {
      "type": "number",
      "description": "Rate per unit for this cash flow line."
    },
    "amount": {
      "type": "number",
      "description": "Total amount for this cash flow line = qty \u00d7 rate. Auto-calculated or pulled from the Cash flow sheet."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the cash flow table."
    }
  },
  "required": [
    "cvr_id",
    "job_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
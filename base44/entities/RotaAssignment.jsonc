{
  "name": "RotaAssignment",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Assigned job"
    },
    "staff_id": {
      "type": "string",
      "description": "Assigned staff member"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "Date of assignment (working date)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle assignment for this job"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the week for this rota entry"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "started",
        "completed"
      ],
      "default": "assigned",
      "description": "Assignment check-in status"
    },
    "started_at": {
      "type": "string",
      "description": "Timestamp when staff started the job"
    },
    "completed_at": {
      "type": "string",
      "description": "Timestamp when staff completed the job"
    },
    "briefing_signed": {
      "type": "boolean",
      "default": false,
      "description": "Whether staff signed off on the job briefing"
    },
    "briefing_signed_at": {
      "type": "string",
      "description": "Timestamp when briefing was signed (end of briefing)"
    },
    "briefing_start_at": {
      "type": "string",
      "description": "Timestamp when staff opened the briefing (start of briefing)"
    },
    "start_time": {
      "type": "string",
      "description": "Shift start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "Shift end time (HH:MM format)"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined"
      ],
      "default": "pending",
      "description": "Staff confirmation status for this shift"
    },
    "is_overtime": {
      "type": "boolean",
      "default": false,
      "description": "True when this is an overtime shift (typically a weekend shift). The whole shift is paid at the overtime rate."
    },
    "rate_multiplier": {
      "type": "number",
      "description": "Pay multiplier for this overtime shift (e.g. 1.5 = time-and-a-half, 2.0 = double time). Falls back to the default OvertimeRate for the day when not set."
    },
    "start_delayed": {
      "type": "boolean",
      "default": false,
      "description": "True when the job started later than its planned start date \u2014 captured during assignment so managers can track delays."
    },
    "actual_start_date": {
      "type": "string",
      "format": "date",
      "description": "Actual date the job started on site \u2014 recorded when the job was delayed from its planned start date"
    },
    "meterage": {
      "type": "number",
      "description": "Meters drilled (for drilling crews, recorded at job completion)"
    },
    "progress_notes": {
      "type": "string",
      "description": "End-of-shift progress notes for multi-day jobs \u2014 visible to management and the next shift"
    },
    "notes": {
      "type": "string",
      "description": "Staff notes for this assignment"
    }
  },
  "required": [
    "job_id",
    "staff_id",
    "assigned_date",
    "week_start"
  ]
}
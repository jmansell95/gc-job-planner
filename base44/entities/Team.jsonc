{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team or group name"
    },
    "description": {
      "type": "string",
      "description": "Team description"
    },
    "parent_team_id": {
      "type": "string",
      "description": "Parent team ID \u2014 set when this is a sub-team under a team group (e.g. Coring and Trial Pit crews sit under the Groundworks parent)."
    },
    "job_type": {
      "type": "string",
      "enum": [
        "groundworks",
        "coring",
        "trial_pit",
        "cp_drilling",
        "rotary_drilling",
        "enabling_works",
        "depot"
      ],
      "description": "Job type this team handles \u2014 staff in this team can only be assigned to matching jobs. Blank/absent = flexible (any job type, e.g. supervisors). Coring and Trial Pit crews are specialised sub-teams of Groundworks."
    },
    "category": {
      "type": "string",
      "enum": [
        "field_ops",
        "depot",
        "management"
      ],
      "description": "Top-level group this team belongs to. 'field_ops' = field crews (drillers, groundworkers) who see their schedule first. 'depot' = depot staff (managers, fitters) who see the admin dashboard first. 'management' = senior leadership with full access."
    },
    "default_landing_page": {
      "type": "string",
      "enum": [
        "/staff-schedule",
        "/admin"
      ],
      "description": "Where staff in this team land first after login. Field teams \u2192 /staff-schedule, Depot/Management \u2192 /admin."
    },
    "allowed_tool_access": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin sections this team can access when viewing the admin dashboard."
    },
    "revenue_stream_type": {
      "type": "string",
      "enum": [
        "none",
        "drilling_meterage",
        "groundworks_unit",
        "coring_unit",
        "trial_pit_unit",
        "day_rate",
        "flat_fee"
      ],
      "default": "none",
      "description": "How revenue is calculated for jobs handled by this crew. 'drilling_meterage' = \u00a3/metre drilled, 'groundworks_unit' = \u00a3/trial pit or unit, 'coring_unit' = \u00a3/core run or metre cored, 'trial_pit_unit' = \u00a3/trial pit, 'day_rate' = fixed daily crew rate, 'flat_fee' = single project fee, 'none' = revenue tracked per asset/task only."
    },
    "billing_default_markup": {
      "type": "number",
      "default": 0,
      "description": "Default markup % applied to this crew's jobs when assigned. Used as the starting markup for revenue calculations."
    },
    "compatible_asset_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Asset types this crew is qualified to operate (e.g. ['rig','lifting']). When assigning equipment, only compatible assets are offered to this crew; mismatches show a soft warning."
    },
    "supervisor_staff_id": {
      "type": "string",
      "description": "Staff member ID of the supervisor who manages this team. The supervisor gets a consolidated view of all crews reporting to them."
    },
    "is_supervisor_team": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a supervisor team that oversees other crews (e.g. a Drilling Supervisor team managing all CP and Rotary crews)."
    },
    "managed_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of teams that this supervisor team oversees."
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team or group name"
    },
    "description": {
      "type": "string",
      "description": "Team description"
    },
    "parent_team_id": {
      "type": "string",
      "description": "Parent team ID \u2014 set when this is a sub-team under a team group"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "groundworks",
        "cp_drilling",
        "rotary_drilling",
        "enabling_works",
        "depot"
      ],
      "description": "Job type this team handles \u2014 staff in this team can only be assigned to matching jobs. Blank/absent = flexible (any job type, e.g. supervisors)."
    },
    "category": {
      "type": "string",
      "enum": [
        "field_ops",
        "depot",
        "management"
      ],
      "description": "Top-level group this team belongs to. 'field_ops' = field crews (drillers, groundworkers) who see their schedule first. 'depot' = depot staff (managers, fitters) who see the admin dashboard first. 'management' = senior leadership with full access."
    },
    "default_landing_page": {
      "type": "string",
      "enum": [
        "/staff-schedule",
        "/admin"
      ],
      "description": "Where staff in this team land first after login. Field teams \u2192 /staff-schedule, Depot/Management \u2192 /admin."
    },
    "allowed_tool_access": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin sections this team can access when viewing the admin dashboard. Keys: overview, jobs, rota, calendar, timesheets, compliance, insights, teams, settings, staff_schedule. Empty = no admin access (field teams that only see their schedule)."
    },
    "supervisor_staff_id": {
      "type": "string",
      "description": "Staff member ID of the supervisor who manages this team. The supervisor gets a consolidated view of all crews reporting to them."
    },
    "is_supervisor_team": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a supervisor team that oversees other crews (e.g. a Drilling Supervisor team managing all CP and Rotary crews). Supervisor teams see a production overview of their reporting crews."
    },
    "managed_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of teams that this supervisor team oversees. Used to build the supervisor's consolidated production view."
    }
  },
  "required": [
    "name"
  ]
}
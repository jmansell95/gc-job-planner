{
  "name": "Reward",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Reward name shown on the catalogue card (e.g. 'Amazon \u00a325 Gift Card', 'GC Branded Hoodie')."
    },
    "description": {
      "type": "string",
      "description": "Short description of what the reward is and any terms (e.g. 'Spend on Amazon UK. Emailed within 5 working days.')."
    },
    "brand": {
      "type": "string",
      "description": "Brand or vendor label (e.g. 'Amazon', 'Tesco', 'Ground Control'). Shown as a small badge on the card."
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name rendered on the reward card tile (e.g. 'Gift', 'ShoppingBag', 'Ticket', 'Coffee')."
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "gift_card",
        "merchandise",
        "experience",
        "custom"
      ],
      "default": "gift_card",
      "description": "Type of reward. 'gift_card' = digital/physical gift card with a GBP value; 'merchandise' = branded physical item; 'experience' = event/day-out; 'custom' = anything else."
    },
    "points_cost": {
      "type": "number",
      "description": "Number of incentive points a staff member must spend to redeem this reward."
    },
    "gift_card_value_gbp": {
      "type": "number",
      "description": "For gift_card rewards, the face value in GBP (e.g. 25 for a \u00a325 gift card). Blank for merchandise/experience/custom."
    },
    "stock_count": {
      "type": "number",
      "description": "Units available to redeem. When 0 the reward shows 'Out of stock' and redeem is disabled. Blank = unlimited (always available)."
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL for the reward card (brand logo or product photo). When blank the icon tile is shown."
    },
    "accent_color": {
      "type": "string",
      "description": "Optional hex colour for the reward card accent (e.g. '#FF9900' for Amazon). Defaults to brand green."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this reward is visible in the staff catalogue. Inactive rewards are hidden but retained for historical redemptions."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the catalogue (lower = first)."
    }
  },
  "required": [
    "name",
    "points_cost",
    "reward_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "JobComment",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Associated job"
    },
    "author_name": {
      "type": "string",
      "description": "Name of commenter"
    },
    "message": {
      "type": "string",
      "description": "Comment text"
    },
    "is_client": {
      "type": "boolean",
      "default": false,
      "description": "Whether this comment is from the client portal"
    },
    "is_system_milestone": {
      "type": "boolean",
      "default": false,
      "description": "True when this comment was auto-generated by the Milestone Auto-Push (an approved investigation log completion). Shown with a distinct badge in the client portal timeline so clients can instantly see verified progress."
    }
  },
  "required": [
    "job_id",
    "author_name",
    "message"
  ]
}
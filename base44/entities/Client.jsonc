{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client company name"
    },
    "parent_client_id": {
      "type": "string",
      "description": "Parent group client ID \u2014 links operating entities (e.g. Concept Engineering, CGL) to their parent holding group (e.g. Phenna Group). When set, this client is displayed as a subsidiary of the parent group in job cards, workload widgets, and financial rollups. Blank for standalone clients and for the parent group record itself."
    },
    "is_holding": {
      "type": "boolean",
      "default": false,
      "description": "True when this client is a parent/holding group (e.g. Phenna Group) that owns operating entities. Holding groups are not typically direct job clients \u2014 jobs are linked to their subsidiary operating entities. Used to distinguish the parent in the Workload Ownership widget and client hierarchy views."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "yard_address": {
      "type": "string",
      "description": "Address of the client's yard, depot or collection point \u2014 where GC crews collect or return gear, materials or samples. Used as the geocode reference for the lat/lng fields."
    },
    "lat": {
      "type": "number",
      "description": "Client yard/depot latitude. Set via the geocode button on the client form. Used for geofence detection \u2014 when a vehicle enters the radius around this location, an arrival event is triggered (e.g. collecting gear from Concept's yard)."
    },
    "lng": {
      "type": "number",
      "description": "Client yard/depot longitude. Set via the geocode button on the client form. Used for geofence detection."
    },
    "geofence_radius_override": {
      "type": "number",
      "description": "Per-client geofence radius override (metres). When set, this radius is used instead of the global default from the geofence config. Useful for large client yards that need a wider zone."
    },
    "is_partner": {
      "type": "boolean",
      "default": false,
      "description": "True when this client is a partner consultancy that subcontracts work to us (e.g. Concept Engineering Consultants). Partner jobs are visually differentiated on cards, boards and dashboards with a distinct badge and workload split."
    },
    "partner_color": {
      "type": "string",
      "description": "Brand accent colour (hex) for this partner client's badges and dashboard widgets. Defaults to a brand-appropriate colour when not set."
    }
  },
  "required": [
    "name"
  ]
}